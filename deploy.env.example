# Copy to .env before running docker-compose.prod.yml.
#
# Keep the password URL-safe (letters, numbers, dashes): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-please-8f2c91

# Optional: database name, and the port the app is published on.
# POSTGRES_DB=chatz
# APP_PORT=3000

# Optional: your domain, only needed for the "https" profile that puts Caddy in front.
# DOMAIN=chatz.example.com

# Public URL with no account: add --profile public to the up command and read the
# random https://<words>.trycloudflare.com address out of `logs tunnel`. No extra
# variables needed, and no port has to be open on this machine.

# POSTGRES_PASSWORD is baked into the database volume the first time it is created.
# Changing it later makes the app fail with "database never became reachable" —
# keep the old value, or wipe the volume with `docker compose -f
# docker-compose.prod.yml down -v` to start the database over (that deletes every
# account and message).

# If you host the app on a platform with its own managed Postgres, skip
# docker-compose.prod.yml and give the app container this instead:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
