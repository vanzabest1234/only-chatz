# Copy to .env before running docker-compose.prod.yml.
#
# Keep the password URL-safe (letters, numbers, dashes): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-please-8f2c91

# Optional: database name, and the port the app is published on.
# POSTGRES_DB=chatz
# APP_PORT=3000

# Optional: your domain, only needed for the "https" profile that puts Caddy in front.
# DOMAIN=chatz.example.com

# If you host the app on a platform with its own managed Postgres, skip
# docker-compose.prod.yml and give the app container this instead:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
